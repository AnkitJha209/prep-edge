generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ----------------- ENUMS -----------------
enum UserRole {
  CANDIDATE
  RECRUITER
  ADMIN
}

enum JobType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERNSHIP
  FREELANCE
}

enum JobStatus {
  ACTIVE
  INACTIVE
  CLOSED
  DRAFT
}

enum ApplicationStatus {
  PENDING
  REVIEWING
  INTERVIEW_SCHEDULED
  INTERVIEW_COMPLETED
  ACCEPTED
  REJECTED
  WITHDRAWN
}


enum InterviewStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  REVIEWED
  ACCEPTED
  REJECTED
  CANCELLED
}

enum QuestionType {
  TECHNICAL
  BEHAVIORAL
  PROBLEM_SOLVING
  CULTURE_FIT
  GENERAL
}

// ----------------- MODELS -----------------
model User {
  id                        String   @id @default(cuid())
  email                     String   @unique
  passwordHash              String
  firstName                 String
  lastName                  String
  role                      UserRole @default(CANDIDATE)
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  // Relations
  recruiterJobs             Job[]         @relation("RecruiterJobs")
  candidateApplications     Application[] @relation("CandidateApplications")
  interviews                Interview[]   @relation("CandidateInterviews")

  @@map("users")
}

model Job {
  id                        String    @id @default(cuid())
  title                     String
  description               String
  requirements              String[]
  salary                    String?
  location                  String?
  type                      JobType
  status                    JobStatus @default(ACTIVE)
  recruiterId               String
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt
  // Relations
  applications              Application[] @relation("JobApplications")
  recruiter                 User          @relation("RecruiterJobs", fields: [recruiterId], references: [id], onDelete: Cascade)

  @@map("jobs")
}

model Application {
  candidateId               String
  id                        String            @id @default(cuid())
  jobId                     String
  resumeUrl                 String
  resumeScore               Float?
  status                    ApplicationStatus @default(PENDING)
  coverLetter               String?
  scoreJustification        String?
  strengths                 String[]
  misingSkills              String
  experienceGap             String[]
  improvementSuggestion     String[]
  overallAssessment         String?
  appliedAt                 DateTime          @default(now())
  updatedAt                 DateTime          @updatedAt

  // Relations
  candidate                 User       @relation("CandidateApplications", fields: [candidateId], references: [id], onDelete: Cascade)
  job                       Job        @relation("JobApplications", fields: [jobId], references: [id], onDelete: Cascade)
  interview                 Interview? @relation("ApplicationInterview")

  @@unique([candidateId, jobId])
  @@map("applications")
}


model Interview {
  id                          String          @id @default(cuid())
  applicationId               String          @unique
  candidateId                 String
  sessionId                   String          @unique
  status                      InterviewStatus @default(SCHEDULED)
  scheduledAt                 DateTime
  startedAt                   DateTime?
  completedAt                 DateTime?
  createdAt                   DateTime        @default(now())
  updatedAt                   DateTime        @updatedAt

  // Relations
  application                 Application         @relation("ApplicationInterview", fields: [applicationId], references: [id], onDelete: Cascade)
  candidate                   User                @relation("CandidateInterviews", fields: [candidateId], references: [id])
  questions                   InterviewQuestion[]
  report                      InterviewReport?

  @@map("interviews")
}

model InterviewQuestion {
  id                          String       @id @default(cuid())
  interviewId                 String
  questionText                String
  questionType                QuestionType
  answerText                  String?
  aiEvaluation                Json? // per-question AI feedback
  orderIndex                  Int
  createdAt                   DateTime     @default(now())

  // Relations
  interview Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)

  @@map("interview_questions")
}

model InterviewReport {
  id                          String     @id @default(cuid())
  interviewId                 String     @unique
  summary                     String
  strengths                   String?
  weaknesses                  String?
  overallScore                Float?
  aiRecommendation            String?
  createdAt                   DateTime   @default(now())

  // Relations
  interview Interview @relation(fields: [interviewId], references: [id])

  @@map("interview_reports")
}
